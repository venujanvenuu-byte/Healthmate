<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Health Record"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#168451"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your daily health information"
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginBottom="25dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Record Date"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnSelectDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Date"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Steps Walked"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/edtSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter steps walked"
            android:inputType="number"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calories Burned (kcal)"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/edtCalories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter calories burned"
            android:inputType="numberDecimal"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Water Intake (ml)"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/edtWater"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter water intake"
            android:inputType="number"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/btnSaveRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Health Record"
            android:backgroundTint="#168451"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</ScrollView>
