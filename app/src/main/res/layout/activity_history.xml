<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Health History"
            android:textColor="#168451"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Track and manage your health journey"
            android:textSize="15sp"
            android:textColor="#66756D"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="25dp"/>

        <!-- Search Bar -->
        <EditText
            android:id="@+id/edtSearch"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Search by date (YYYY-MM-DD)"
            android:inputType="text"
            android:singleLine="true"
            android:padding="15dp"
            android:textSize="15sp"
            android:textColor="#202C25"
            android:textColorHint="#87958D"
            android:backgroundTint="#168451"
            android:layout_marginBottom="25dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saved Health Records"
            android:textColor="#202C25"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginBottom="15dp"/>

        <!-- Existing Records -->
        <LinearLayout
            android:id="@+id/layoutRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <TextView
            android:id="@+id/txtNoRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No health records found"
            android:textColor="#777777"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="25dp"/>

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Dashboard"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#168451"
            android:layout_marginTop="25dp"/>

    </LinearLayout>
</ScrollView>
