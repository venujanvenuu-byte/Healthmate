<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Health Record"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#168451"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update your saved health information"
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginBottom="25dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Record Date"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnEditDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Date"
            android:textAllCaps="false"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Steps Walked"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/edtEditSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter steps walked"
            android:inputType="number"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calories Burned (kcal)"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/edtEditCalories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter calories burned"
            android:inputType="numberDecimal"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Water Intake (ml)"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/edtEditWater"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter water intake"
            android:inputType="number"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/btnUpdateRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Health Record"
            android:textAllCaps="false"
            android:backgroundTint="#168451"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnCancelEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textAllCaps="false"/>

    </LinearLayout>
</ScrollView>
